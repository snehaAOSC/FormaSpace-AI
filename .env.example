# =============================================================================
# FormaSpace AI - Environment Configuration Example
# Copy to .env (backend) and frontend/.env as appropriate.
# NEVER expose secret keys (SUPABASE_SERVICE_ROLE_KEY, AI_API_KEY, JWT_SECRET)
# in frontend code!
# =============================================================================

# --- Application Mode ---
APP_ENV=development
APP_NAME=FormaSpace AI
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication & Security ---
# Used for local JWT signing when Supabase Auth is not configured
JWT_SECRET=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase Configuration (Database, Auth, Storage) ---
# Leave blank to run with built-in local SQLite + local disk storage for instant dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=formaspace-assets

# --- Modular AI Image Editing Provider ---
# Supported: "openai" (gpt-image-1 image-to-image edit), "gemini" (gemini-2.5-flash-image),
# "stability" (Stability AI image-to-image), or "demo" (local Pillow simulation)
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-image-1
AI_VISION_MODEL=gpt-4o-mini

# --- Optional External Video Generation Provider ---
# Supported: "runway", "luma", or "none" (interface shows browser motion preview + API readiness)
VIDEO_PROVIDER=none
VIDEO_API_KEY=

# --- Optional Google OAuth (via Supabase Auth or direct OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

